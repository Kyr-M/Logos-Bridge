{
   "name": "Grouped multi-word highlight",
   "description": "Highlight multiple words in different groups in web pages.",
   "icons": {
      "100": "img/logo 100x100.png",
      "128": "img/logo 128x128.png",
      "19": "img/logo 19x19.png",
      "48": "img/logo 48x48.png"
   },
   "browser_action": {
      "default_icon": "img/logo 19x19.png",
      "default_popup": "popup.html"
   },

   "permissions": [ "tabs", "http://*/*", "https://*/*", "storage" ],

   "content_scripts": [ {
      "all_frames": true,
      "css": [ "css/highlight.css", "css/main.css","css/fonts.css","css/popup.css","css/tabs_menu.css","css/toggle_auto_hightlight.css","css/toggle.css"],
      "js": [ "js/content-action.js", "js/fonts.js","js/hex_color_pick.js","js/popup.js","js/tabs.js","js/toggle_auto_hightlight.js" ],
      "run_at": "document_idle",
      "matches": [ "http://*/*", "https://*/*", "file://*/*" ]
   } ],

   "update_url": "https://clients2.google.com/service/update2/crx",
   "manifest_version": 2,
   "version": "0.1"
}
